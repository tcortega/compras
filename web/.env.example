# Empty or "stub" serves the in-process Phase 0 slice (Volta Redonda, RJ, 2024).
# Compose sets this to http://api:5080. Local API: http://127.0.0.1:5080
API_BASE_URL=stub
# Staging triage at /interno/triagem and review at /interno/rotulos. Set 0 to hide both.
STAGING_TRIAGE=1
# Optional path for appended triage labels. Defaults to ../labels/triage-labels.csv.
# TRIAGE_LABELS_PATH=/tmp/triage-labels.csv
# Directory with labels/adjudication/*-blind.csv. Empty or missing is fine.
# COMPRAS_DATA_DIR=/path/to/compras-data
